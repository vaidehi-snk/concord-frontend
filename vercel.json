{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/login", "destination": "/app.html" },
    { "source": "/register", "destination": "/app.html" },
    { "source": "/privacy", "destination": "/app.html" },
    { "source": "/terms", "destination": "/app.html" },
    { "source": "/security", "destination": "/app.html" },
    { "source": "/contact", "destination": "/app.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/app/:path*", "destination": "/app.html" },
    { "source": "/respond/:path*", "destination": "/app.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(index.html|app.html|404.html)?", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
